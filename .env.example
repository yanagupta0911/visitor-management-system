# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./visitor.db

# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Where uploaded photos are stored.
CHECKIN_PHOTO_DIR=checkin_photos
CHECKOUT_PHOTO_DIR=checkout_photos

# Maximum accepted photo upload size, in megabytes.
MAX_PHOTO_SIZE_MB=5
